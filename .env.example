# Existing production environment variables (fill with your real credentials)
# URL from Supabase Project Settings / Connect.
SUPABASE_URL=
# Optional when a service-role key is provided (legacy anon key or publishable key).
SUPABASE_ANON_KEY=
# Required by NOVA; this key can also initialize the server client if anon key is omitted.
SUPABASE_SERVICE_ROLE_KEY=
BOT_TOKEN=
# Optional. If omitted, a stable secret is derived from BOT_TOKEN for webhook verification.
TELEGRAM_WEBHOOK_SECRET=
JWT_SECRET=
WEBAPP_URL=
API_BASE_URL=
PORT=5000

# NOVA — credentials stay on the server; never place them in public/
NOVA_ENABLED=false

# Privacy-first routing. Default: Cloudflare only. Optional fallbacks must be explicitly listed.
NOVA_PROVIDER_ORDER=cloudflare

# Optional fallback: OpenRouter Free. Disabled unless 'openrouter' is added to NOVA_PROVIDER_ORDER.
OPENROUTER_API_KEY=
NOVA_OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,inclusionai/ling-3.2-flash:free,dots-studio/dots-3-note-preview:free,particle-ai/particle-1:free,recursive/flint-v1.0:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VPN CUBA NOVA
NOVA_OPENROUTER_DAILY_LIMIT=45
NOVA_OPENROUTER_RPM_LIMIT=18
# Maximo de modelos OpenRouter probados por cada mensaje; el resto rota en mensajes siguientes.
NOVA_OPENROUTER_MAX_MODEL_ATTEMPTS_PER_MESSAGE=2

# Optional external fallbacks; disabled unless explicitly listed in NOVA_PROVIDER_ORDER.
ZAI_API_KEY=
NOVITA_API_KEY=

# Primary: Cloudflare Workers AI, IBM Granite 4.0 H Micro (ZDR; 10,000 free Neurons/day).
# Create the token from the Workers AI dashboard's "Use REST API" flow.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Local safety cap below Cloudflare's 10,000 free Neurons/day allocation.
NOVA_CLOUDFLARE_DAILY_NEURON_LIMIT=8500
