# Existing production environment variables (fill with your real credentials)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOT_TOKEN=
# Optional. If omitted, a stable secret is derived from BOT_TOKEN for webhook verification.
TELEGRAM_WEBHOOK_SECRET=
JWT_SECRET=
WEBAPP_URL=
API_BASE_URL=
PORT=5000

# NOVA — Free API providers (keys stay on the server; never place them in public/)
NOVA_ENABLED=false

# Primary provider: OpenRouter Free. Free-model router, no credit purchase required.
OPENROUTER_API_KEY=
NOVA_OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VPN CUBA NOVA
NOVA_OPENROUTER_DAILY_LIMIT=45
NOVA_OPENROUTER_RPM_LIMIT=18

# Backup provider: Cloudflare Workers AI Free allocation.
# Create the token from the Workers AI dashboard's "Use REST API" flow.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NOVA_CLOUDFLARE_DAILY_NEURON_LIMIT=7500
